# Google OAuth Web application credentials
# Register the exact callback in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/google/callback

# Required for public HTTPS or embedded previews; leave false for local HTTP.
CODEDARPAN_PUBLIC_HTTPS=false

# Existing deployment settings
CODEDARPAN_REQUIRE_AUTH=true
CODEDARPAN_TOKEN_SECRET=replace-with-a-long-random-secret
GITHUB_TOKEN=
